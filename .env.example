# Copy to .env.local for local development. Set the same keys in Vercel →
# Project → Settings → Environment Variables. Never commit real values.

# Public site URL (canonical links, sitemap, OG images, QR codes). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.in

# ---- Enquiry form delivery (set at least one in production) ----
# Resend (https://resend.com): API key, where enquiries go, and a verified sender.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL="Rebuilt Pixel <enquiries@your-domain.in>"
# Optional: also POST each lead as JSON to a webhook (e.g. Google Apps Script → Sheet).
LEAD_WEBHOOK_URL=

# ---- Analytics (optional) ----
# Vercel Analytics turns on automatically when deployed on Vercel (cookieless).
# Plausible (cookieless): your domain as registered in Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Analytics 4 and Meta Pixel set cookies. If either is set, a consent
# notice appears and they load only after the visitor accepts.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
